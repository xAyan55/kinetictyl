<%- include('../../components/header', { title: 'Create Server' }) %>

<main class="h-screen m-auto">
  <div class="flex h-screen">
    <!-- Sidebar -->
    <div class="w-60 h-full">
      <%- include('../../components/template') %>
    </div>
    <!-- Content -->
    <div id="page-content" class="flex-1 p-6 overflow-y-auto pt-16">
      <div class="sm:flex sm:items-center px-8 pt-4">
        <div class="sm:flex-auto">
          <h1 class="text-base font-medium leading-6 text-neutral-800 dark:text-white"><%= req.translations.adminCreateServerTitle || 'Create Server' %></h1>
          <p class="mt-1 tracking-tight text-sm text-neutral-500">Deploy a new Minecraft server with automatic software provisioning.</p>
        </div>
      </div>

      <div id="nodeForm" class="mt-6 px-8 w-full">
        <div class="bg-neutral-50 dark:bg-neutral-800/20 rounded-xl p-5 border border-neutral-200 dark:border-white/5">
          <form id="createServerForm" method="POST" action="/admin/servers/create">

            <!-- General Category -->
            <h2 class="text-neutral-700 dark:text-neutral-300 text-lg font-semibold mb-4">General Configuration</h2>
            <div class="grid grid-cols-2 gap-4 mb-6">
              <div>
                <label for="serverName" class="text-neutral-700 dark:text-neutral-400 text-sm tracking-tight mb-2"><%= req.translations.name || 'Server Name' %>:</label>
                <div class="flex items-center space-x-2">
                  <input id="serverName" name="name" class="rounded-xl focus:ring focus:ring-neutral-800/10 focus:border-neutral-800/20 text-neutral-800 dark:text-white text-sm mt-2 mb-4 w-full hover:bg-white/5 px-4 py-2 bg-neutral-400/10 dark:bg-neutral-600/20 placeholder:text-neutral-950/50 dark:placeholder:text-white/20 border border-neutral-800/10 dark:border-white/5" placeholder="<%= user.username %>'s server">
                  <div class="flex-shrink-0 p-2 mb-1 -ml-5 cursor-pointer" onclick="generateRandomName()">
                    <%- icon('refresh-cw', { size: 16, class: 'text-neutral-500 dark:text-neutral-300' }) %>
                  </div>
                </div>
              </div>

              <div>
                <label for="serverDescription" class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-400 text-sm tracking-tight mb-2">
                  <%- icon('file-text', { size: 14, class: 'shrink-0' }) %>
                  <%= req.translations.description || 'Description' %>:
                </label>
                <input id="serverDescription" name="description" class="rounded-xl focus:ring focus:ring-neutral-800/10 focus:border-neutral-800/20 text-neutral-800 dark:text-white text-sm mt-2 mb-4 w-full hover:bg-white/5 px-4 py-2 bg-neutral-400/10 dark:bg-neutral-600/20 placeholder:text-neutral-950/50 dark:placeholder:text-white/20 border border-neutral-800/10 dark:border-white/5" placeholder="<%= user.username %>'s server description">
              </div>

              <div>
                <label class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-400 text-sm tracking-tight mb-2">
                  <%- icon('user', { size: 14, class: 'shrink-0' }) %>
                  <%= req.translations.user || 'Owner' %>:
                </label>
                <select id="serverUser" name="ownerId" class="hidden">
                  <% users.forEach(u => { %>
                    <option value="<%= u.id %>" <%= u.id === user.id ? 'selected' : '' %>><%= u.username %></option>
                  <% }); %>
                </select>
                <div class="custom-select mt-2 mb-4" data-for="serverUser"></div>
              </div>

              <div>
                <label class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-400 text-sm tracking-tight mb-2">
                  <%- icon('server', { size: 14, class: 'shrink-0' }) %>
                  <%= req.translations.Node || 'Node Location' %>:
                </label>
                <select id="serverNode" name="nodeId" class="hidden">
                  <% if (nodes.length > 0) { %>
                    <% nodes.forEach(n => { %>
                      <option value="<%= n.id %>"><%= n.name %></option>
                    <% }); %>
                  <% } else { %>
                    <option value="" disabled selected>No nodes available</option>
                  <% } %>
                </select>
                <div class="custom-select mt-2 mb-4" data-for="serverNode"></div>
              </div>
            </div>

            <!-- Software & Version Category -->
            <h2 class="text-neutral-700 dark:text-neutral-300 text-lg font-semibold mb-4">Minecraft Software & Runtime</h2>
            <div class="grid grid-cols-3 gap-4 mb-6">
              <div>
                <label class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-400 text-sm tracking-tight mb-2">
                  <%- icon('box', { size: 14, class: 'shrink-0' }) %>
                  Server Software:
                </label>
                <select id="softwareType" name="softwareType" class="hidden">
                  <option value="paper" selected>Paper (Recommended)</option>
                  <option value="purpur">Purpur</option>
                  <option value="vanilla">Vanilla</option>
                  <option value="fabric">Fabric</option>
                  <option value="forge">Forge</option>
                  <option value="neoforge">NeoForge</option>
                  <option value="spigot">Spigot</option>
                </select>
                <div class="custom-select mt-2 mb-4" data-for="softwareType"></div>
              </div>

              <div>
                <label class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-400 text-sm tracking-tight mb-2">
                  <%- icon('tag', { size: 14, class: 'shrink-0' }) %>
                  Minecraft Version:
                </label>
                <select id="softwareVersion" name="softwareVersion" class="hidden">
                  <option value="1.21.4" selected>1.21.4</option>
                  <option value="1.21.3">1.21.3</option>
                  <option value="1.21.1">1.21.1</option>
                  <option value="1.20.4">1.20.4</option>
                  <option value="1.20.1">1.20.1</option>
                  <option value="1.19.4">1.19.4</option>
                  <option value="1.18.2">1.18.2</option>
                  <option value="1.16.5">1.16.5</option>
                  <option value="1.12.2">1.12.2</option>
                  <option value="1.8.8">1.8.8</option>
                </select>
                <div class="custom-select mt-2 mb-4" data-for="softwareVersion"></div>
              </div>

              <div>
                <label class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-400 text-sm tracking-tight mb-2">
                  <%- icon('terminal', { size: 14, class: 'shrink-0' }) %>
                  Java Runtime Version:
                </label>
                <select id="javaVersion" name="javaVersion" class="hidden">
                  <option value="21" selected>Java 21 (Recommended for 1.20.5+)</option>
                  <option value="17">Java 17 (Recommended for 1.17 - 1.20.4)</option>
                  <option value="11">Java 11 (Legacy 1.12 - 1.16)</option>
                  <option value="8">Java 8 (Legacy 1.8.8)</option>
                </select>
                <div class="custom-select mt-2 mb-4" data-for="javaVersion"></div>
              </div>
            </div>

            <!-- Startup Flags & Command Preview -->
            <div class="grid grid-cols-2 gap-4 mb-6">
              <div>
                <label for="startupFlags" class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-400 text-sm tracking-tight mb-2">
                  <%- icon('command', { size: 14, class: 'shrink-0' }) %>
                  Startup Flags:
                </label>
                <input id="startupFlags" name="flags" value="-Xms128M -Xmx{{SERVER_MEMORY}}M"
                  class="rounded-xl focus:ring focus:ring-neutral-800/10 focus:border-neutral-800/20 text-neutral-800 dark:text-white text-sm mt-2 mb-4 w-full hover:bg-white/5 px-4 py-2 bg-neutral-400/10 dark:bg-neutral-600/20 border border-neutral-800/10 dark:border-white/5">
              </div>

              <div>
                <label for="startupCommandPreview" class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-400 text-sm tracking-tight mb-2">
                  <%- icon('play', { size: 14, class: 'shrink-0' }) %>
                  Startup Command Preview:
                </label>
                <input id="startupCommandPreview" readonly value="java -Xms128M -Xmx1024M -jar server.jar nogui"
                  class="rounded-xl text-neutral-500 dark:text-neutral-400 text-sm mt-2 mb-4 w-full px-4 py-2 bg-neutral-200/50 dark:bg-neutral-800/50 border border-neutral-800/10 dark:border-white/5 cursor-not-allowed font-mono">
              </div>
            </div>

            <!-- Server Settings Toggles -->
            <h2 class="text-neutral-700 dark:text-neutral-300 text-lg font-semibold mb-4">Minecraft Server Settings</h2>
            <div class="grid grid-cols-4 gap-4 mb-6">
              <div class="bg-neutral-100 dark:bg-neutral-700/20 rounded-xl p-4 border border-neutral-300 dark:border-white/5">
                <div class="flex items-center justify-between">
                  <div>
                    <h3 class="text-sm font-medium text-neutral-800 dark:text-white">Auto Restart</h3>
                    <p class="text-xs text-neutral-500">Restart on crash</p>
                  </div>
                  <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" name="autoRestart" id="autoRestart" checked class="sr-only peer" value="true">
                    <div class="w-11 h-6 bg-neutral-300 dark:bg-neutral-700 peer-focus:ring-2 peer-focus:ring-blue-300 dark:peer-focus:ring-blue-800 rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-neutral-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
                  </label>
                </div>
              </div>

              <div class="bg-neutral-100 dark:bg-neutral-700/20 rounded-xl p-4 border border-neutral-300 dark:border-white/5">
                <div class="flex items-center justify-between">
                  <div>
                    <h3 class="text-sm font-medium text-neutral-800 dark:text-white">Accept EULA</h3>
                    <p class="text-xs text-neutral-500">Mojang EULA agreement</p>
                  </div>
                  <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" name="eula" id="eula" checked class="sr-only peer" value="true">
                    <div class="w-11 h-6 bg-neutral-300 dark:bg-neutral-700 peer-focus:ring-2 peer-focus:ring-blue-300 dark:peer-focus:ring-blue-800 rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-neutral-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
                  </label>
                </div>
              </div>

              <div class="bg-neutral-100 dark:bg-neutral-700/20 rounded-xl p-4 border border-neutral-300 dark:border-white/5">
                <div class="flex items-center justify-between">
                  <div>
                    <h3 class="text-sm font-medium text-neutral-800 dark:text-white">Online Mode</h3>
                    <p class="text-xs text-neutral-500">Mojang authentication</p>
                  </div>
                  <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" name="onlineMode" id="onlineMode" checked class="sr-only peer" value="true">
                    <div class="w-11 h-6 bg-neutral-300 dark:bg-neutral-700 peer-focus:ring-2 peer-focus:ring-blue-300 dark:peer-focus:ring-blue-800 rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-neutral-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
                  </label>
                </div>
              </div>

              <div class="bg-neutral-100 dark:bg-neutral-700/20 rounded-xl p-4 border border-neutral-300 dark:border-white/5">
                <div class="flex items-center justify-between">
                  <div>
                    <h3 class="text-sm font-medium text-neutral-800 dark:text-white">Whitelist</h3>
                    <p class="text-xs text-neutral-500">Player access control</p>
                  </div>
                  <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" name="whitelist" id="whitelist" class="sr-only peer" value="true">
                    <div class="w-11 h-6 bg-neutral-300 dark:bg-neutral-700 peer-focus:ring-2 peer-focus:ring-blue-300 dark:peer-focus:ring-blue-800 rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-neutral-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
                  </label>
                </div>
              </div>
            </div>

            <!-- Resources Category -->
            <h2 class="text-neutral-700 dark:text-neutral-300 text-lg font-semibold mb-4">Hardware Resources</h2>
            <div class="grid grid-cols-3 gap-4 mb-6">
              <div>
                <label class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-400 text-sm tracking-tight mb-2">
                  <%- icon('cpu', { size: 14, class: 'shrink-0' }) %>
                  CPU Cores:
                </label>
                <input type="hidden" id="serverCPU" name="Cpu" value="100">
                <div class="flex items-stretch mt-2 mb-1 gap-0">
                  <input id="serverCPUDisplay" type="number" min="0.5" step="0.5" value="1"
                    class="rounded-l-xl flex-1 focus:ring focus:ring-neutral-800/10 focus:border-neutral-800/20 text-neutral-800 dark:text-white text-sm hover:bg-white/5 px-4 py-2 bg-neutral-400/10 dark:bg-neutral-600/20 border border-r-0 border-neutral-800/10 dark:border-white/5">
                  <select id="serverCPUUnit" class="rounded-r-xl text-sm px-2 py-2 bg-neutral-200 dark:bg-neutral-700 text-neutral-800 dark:text-white border border-neutral-800/10 dark:border-white/5 cursor-pointer">
                    <option value="cores" selected>Cores</option>
                    <option value="percent">%</option>
                  </select>
                </div>
                <p class="text-xs text-neutral-400 mb-3">1 core = 100%</p>
              </div>

              <div>
                <label class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-400 text-sm tracking-tight mb-2">
                  <%- icon('memory-stick', { size: 14, class: 'shrink-0' }) %>
                  Memory (RAM):
                </label>
                <input type="hidden" id="serverMemory" name="Memory" value="1024">
                <div class="flex items-stretch mt-2 mb-1 gap-0">
                  <input id="serverMemoryDisplay" type="number" min="1" value="1024"
                    class="rounded-l-xl flex-1 focus:ring focus:ring-neutral-800/10 focus:border-neutral-800/20 text-neutral-800 dark:text-white text-sm hover:bg-white/5 px-4 py-2 bg-neutral-400/10 dark:bg-neutral-600/20 border border-r-0 border-neutral-800/10 dark:border-white/5">
                  <select id="serverMemoryUnit" class="rounded-r-xl text-sm px-2 py-2 bg-neutral-200 dark:bg-neutral-700 text-neutral-800 dark:text-white border border-neutral-800/10 dark:border-white/5 cursor-pointer">
                    <option value="1" selected>MB</option>
                    <option value="1024">GB</option>
                  </select>
                </div>
                <p class="text-xs text-neutral-400 mb-3">Min 128 MB</p>
              </div>

              <div>
                <label class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-400 text-sm tracking-tight mb-2">
                  <%- icon('database', { size: 14, class: 'shrink-0' }) %>
                  Storage (Disk):
                </label>
                <input type="hidden" id="serverStorage" name="Storage" value="20480">
                <div class="flex items-stretch mt-2 mb-1 gap-0">
                  <input id="serverStorageDisplay" type="number" min="1" value="20"
                    class="rounded-l-xl flex-1 focus:ring focus:ring-neutral-800/10 focus:border-neutral-800/20 text-neutral-800 dark:text-white text-sm hover:bg-white/5 px-4 py-2 bg-neutral-400/10 dark:bg-neutral-600/20 border border-r-0 border-neutral-800/10 dark:border-white/5">
                  <select id="serverStorageUnit" class="rounded-r-xl text-sm px-2 py-2 bg-neutral-200 dark:bg-neutral-700 text-neutral-800 dark:text-white border border-neutral-800/10 dark:border-white/5 cursor-pointer">
                    <option value="1">MB</option>
                    <option value="1024" selected>GB</option>
                  </select>
                </div>
                <p class="text-xs text-neutral-400 mb-3">Min 128 MB</p>
              </div>
            </div>

            <!-- Ports Section -->
            <h2 class="text-neutral-700 dark:text-neutral-300 text-lg font-semibold mb-4">Port Allocation</h2>
            <div class="mb-6">
              <input type="hidden" id="serverPorts" name="Ports" value='[{"Port":"25565:25565","primary":true}]'>
              <button type="button" id="assignPortsBtn" class="w-full inline-flex items-center justify-between rounded-xl bg-neutral-100 dark:bg-neutral-700/30 hover:bg-neutral-200 dark:hover:bg-neutral-700 text-neutral-800 dark:text-white px-4 py-2.5 text-sm font-medium border border-neutral-200 dark:border-white/5 transition">
                <span class="flex items-center gap-2">
                  <%- icon('radio-tower', { size: 14, class: 'shrink-0' }) %>
                  Assign Ports
                </span>
                <span id="assignPortsCount" class="text-xs text-neutral-500 dark:text-neutral-400">Primary: 25565</span>
              </button>
            </div>

            <!-- Submit Button -->
            <div class="col-span-2">
              <button type="submit" class="w-full md:w-auto rounded-xl bg-neutral-950 dark:bg-white hover:bg-neutral-800 dark:hover:bg-neutral-200 text-white dark:text-neutral-900 px-6 py-2.5 text-sm font-semibold shadow-md transition focus:outline focus:outline-2 focus:outline-offset-2">
                <%= req.translations.create || 'Create Minecraft Server' %>
              </button>
            </div>

          </form>
        </div>
      </div>
    </div>
  </div>
</main>

<div id="portsModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 p-4">
  <div class="w-full max-w-4xl rounded-2xl border border-neutral-200 dark:border-neutral-700/60 bg-white dark:bg-neutral-900 shadow-xl">
    <div class="flex items-center justify-between border-b border-neutral-200 dark:border-neutral-700/60 px-5 py-4">
      <h2 class="text-sm font-semibold text-neutral-800 dark:text-white">Assign Server Ports</h2>
      <button type="button" id="closePortsModal" class="p-1 rounded-lg text-neutral-400 hover:text-neutral-800 dark:hover:text-white transition">
        <%- icon('x', { size: 16, class: 'shrink-0' }) %>
      </button>
    </div>
    <div class="p-5">
      <div id="portsRows" class="space-y-3"></div>
      <button type="button" id="addPortRow" class="mt-4 rounded-xl border border-neutral-200 dark:border-white/10 px-3 py-2 text-sm text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-white/5 transition">Add Port</button>
    </div>
    <div class="flex justify-end gap-2 border-t border-neutral-200 dark:border-neutral-700/60 px-5 py-4">
      <button type="button" id="savePortsModal" class="rounded-xl bg-neutral-900 dark:bg-white px-4 py-2 text-sm font-medium text-white dark:text-neutral-900 transition hover:bg-neutral-700 dark:hover:bg-neutral-100">Save Ports</button>
    </div>
  </div>
</div>

<%- include('../../components/toast') %>
<%- include('../../components/loadingPopup') %>

<script nonce="<%- nonce %>">
  document.addEventListener('DOMContentLoaded', () => {
    const softwareTypeSelect = document.getElementById('softwareType');
    const softwareVersionSelect = document.getElementById('softwareVersion');
    const javaVersionSelect = document.getElementById('javaVersion');
    const startupFlagsInput = document.getElementById('startupFlags');
    const commandPreview = document.getElementById('startupCommandPreview');
    const serverMemoryInput = document.getElementById('serverMemory');
    const form = document.getElementById('createServerForm');

    // Dynamically fetch versions when software type changes
    async function loadSoftwareVersions(type) {
      try {
        const res = await fetch('/api/mcjars/versions/' + type);
        const data = await res.json();
        if (data && Array.isArray(data.versions) && data.versions.length > 0) {
          softwareVersionSelect.innerHTML = '';
          data.versions.forEach(ver => {
            const opt = document.createElement('option');
            opt.value = ver;
            opt.textContent = ver;
            softwareVersionSelect.appendChild(opt);
          });
          softwareVersionSelect.selectedIndex = 0;
          updateJavaVersionRecommendation(data.versions[0]);
        }
      } catch (err) {
        console.error('Error fetching MCJars versions:', err);
      }
    }

    function updateJavaVersionRecommendation(mcVer) {
      if (!mcVer) return;
      const parts = mcVer.split('.').map(Number);
      const minor = parts[1] || 0;
      const patch = parts[2] || 0;

      if (minor >= 20 && patch >= 5) {
        javaVersionSelect.value = '21';
      } else if (minor >= 17) {
        javaVersionSelect.value = '17';
      } else if (minor >= 12) {
        javaVersionSelect.value = '11';
      } else {
        javaVersionSelect.value = '8';
      }
      javaVersionSelect.dispatchEvent(new Event('change', { bubbles: true }));
    }

    function updateCommandPreview() {
      const mem = serverMemoryInput.value || '1024';
      const flags = startupFlagsInput.value.replace('{{SERVER_MEMORY}}', mem);
      commandPreview.value = 'java ' + flags + ' -jar server.jar nogui';
    }

    softwareTypeSelect.addEventListener('change', () => {
      loadSoftwareVersions(softwareTypeSelect.value);
      updateCommandPreview();
    });

    softwareVersionSelect.addEventListener('change', () => {
      updateJavaVersionRecommendation(softwareVersionSelect.value);
    });

    startupFlagsInput.addEventListener('input', updateCommandPreview);
    serverMemoryInput.addEventListener('input', updateCommandPreview);

    // Initial load
    updateCommandPreview();

    // Form submit
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const data = Object.fromEntries(formData);

      const loader = showLoadingPopup('Creating Server', 'Provisioning Minecraft server via Kinetictyl Agent...');
      loader.updateProgress(30, 'Setting up software and runtime...');

      fetch('/admin/servers/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      })
        .then(res => {
          if (!res.ok) throw new Error('Server creation failed');
          return res;
        })
        .then(() => {
          loader.updateProgress(100, 'Server created!');
          setTimeout(() => {
            loader.close();
            showToast('Minecraft server created and queued for deployment!', 'success');
            setTimeout(() => { window.location.href = '/admin/servers'; }, 800);
          }, 500);
        })
        .catch(err => {
          loader.close();
          showToast('Failed to create server: ' + err.message, 'error');
        });
    });

    // MB/GB sync helpers
    function syncUnit(displayId, unitId, hiddenId) {
      const display = document.getElementById(displayId);
      const unit = document.getElementById(unitId);
      const hidden = document.getElementById(hiddenId);
      function update() {
        hidden.value = Math.round(parseFloat(display.value || 0) * parseInt(unit.value));
        updateCommandPreview();
      }
      display.addEventListener('input', update);
      unit.addEventListener('change', update);
      update();
    }
    syncUnit('serverMemoryDisplay', 'serverMemoryUnit', 'serverMemory');
    syncUnit('serverStorageDisplay', 'serverStorageUnit', 'serverStorage');
  });

  const listA = ["Charged", "Fiery", "Mystical", "Dark", "Angry", "Enchanted", "Blazing", "Cursed", "Frozen", "Swift", "Ancient"];
  const listB = ["Creeper", "Dragon", "Zombie", "Ghoul", "Enderman", "Skeleton", "Wither", "Blaze", "Witch", "Slime", "Spider"];

  function generateRandomName() {
    const randomA = listA[Math.floor(Math.random() * listA.length)];
    const randomB = listB[Math.floor(Math.random() * listB.length)];
    document.getElementById("serverName").value = randomA + " " + randomB;
  }
</script>

<script nonce="<%- nonce %>" src="/javascript/server-create.js"></script>
