{
  "name": "kinetictyl-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Kinetictyl - Self-hosted Minecraft game server management panel without Docker",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "start": "pm2 start ecosystem.config.js",
    "stop": "pm2 stop ecosystem.config.js",
    "restart": "pm2 restart ecosystem.config.js",
    "test": "npm run test --workspaces"
  },
  "keywords": [
    "minecraft",
    "control-panel",
    "pterodactyl",
    "game-server",
    "management"
  ],
  "author": "Kinetictyl Team",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
