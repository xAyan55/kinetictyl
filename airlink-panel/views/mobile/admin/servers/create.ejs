<%- include('../../components/header', { title: 'Create Server' }) %>

<main id="page-content">
  <%- include('../../components/template') %>

  <div class="px-4 py-5">
    <div class="flex items-start justify-between mb-5">
      <div class="sm:flex-auto">
        <h1 class="text-base font-medium leading-6 text-neutral-800 dark:text-white"><%= req.translations.adminCreateServerTitle || 'Create Server' %></h1>
        <p class="mt-1 tracking-tight text-sm text-neutral-500">Deploy a new Minecraft server with automatic software provisioning.</p>
      </div>
    </div>

    <div id="nodeForm" class="mt-4 w-full">
      <div class="rounded-xl bg-neutral-50 dark:bg-neutral-800/20 border border-neutral-200 dark:border-white/5 p-5">
        <form id="createServerForm" method="POST" action="/admin/servers/create">

          <!-- General Category -->
          <h2 class="text-neutral-700 dark:text-neutral-300 text-lg font-semibold mb-4">General</h2>
          <div class="grid grid-cols-1 gap-4 mb-6">
            <div>
              <label for="serverName" class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-400 text-sm tracking-tight mb-2">
                <%- icon('file', { size: 14, class: 'shrink-0' }) %>
                <%= req.translations.name || 'Server Name' %>:
              </label>
              <div class="flex items-center space-x-2">
                <input id="serverName" name="name" class="rounded-xl focus:ring focus:ring-neutral-800/10 focus:border-neutral-800/20 text-neutral-800 dark:text-white text-sm mt-2 mb-4 w-full hover:bg-white/5 px-4 py-2 bg-neutral-400/10 dark:bg-neutral-600/20 placeholder:text-neutral-950/50 dark:placeholder:text-white/20 border border-neutral-800/10 dark:border-white/5" placeholder="<%= user.username %>'s server">
                <div class="flex-shrink-0 p-2 mb-1 -ml-5 cursor-pointer" onclick="generateRandomName()">
                  <%- icon('refresh-cw', { size: 16, class: 'text-neutral-400' }) %>
                </div>
              </div>
            </div>

            <div>
              <label for="serverDescription" class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-400 text-sm tracking-tight mb-2">
                <%- icon('file', { size: 14, class: 'shrink-0' }) %>
                <%= req.translations.description || 'Description' %>:
              </label>
              <input id="serverDescription" name="description" class="rounded-xl focus:ring focus:ring-neutral-800/10 focus:border-neutral-800/20 text-neutral-800 dark:text-white text-sm mt-2 mb-4 w-full hover:bg-white/5 px-4 py-2 bg-neutral-400/10 dark:bg-neutral-600/20 placeholder:text-neutral-950/50 dark:placeholder:text-white/20 border border-neutral-800/10 dark:border-white/5" placeholder="<%= user.username %>'s server description">
            </div>

            <div>
              <label for="serverUser" class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-400 text-sm tracking-tight mb-2">
                <%- icon('user', { size: 16, class: 'shrink-0' }) %>
                <%= req.translations.user || 'Owner' %>:
              </label>
              <select id="serverUser" name="ownerId" class="rounded-xl focus:ring focus:ring-neutral-800/10 focus:border-neutral-800/20 text-neutral-800 dark:text-white text-sm mt-2 mb-4 w-full hover:bg-white/5 px-4 py-2 bg-neutral-400/10 dark:bg-neutral-600/20 border border-neutral-800/10 dark:border-white/5">
                <% users.forEach(u => { %>
                  <option value="<%= u.id %>" <%= u.id === user.id ? 'selected' : '' %>><%= u.username %></option>
                <% }); %>
              </select>
            </div>

            <div>
              <label for="serverNode" class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-400 text-sm tracking-tight mb-2">
                <%- icon('server', { size: 14, class: 'shrink-0' }) %>
                <%= req.translations.Node || 'Node Location' %>:
              </label>
              <select id="serverNode" name="nodeId" class="block w-full rounded-xl bg-neutral-400/10 dark:bg-neutral-600/20 border border-neutral-800/10 dark:border-white/5 text-neutral-800 dark:text-white text-sm px-4 py-2 hover:bg-white/5">
                <% if (nodes.length > 0) { %>
                  <% nodes.forEach(n => { %>
                    <option value="<%= n.id %>"><%= n.name %></option>
                  <% }); %>
                <% } else { %>
                  <option value="" disabled selected>No nodes available</option>
                <% } %>
              </select>
            </div>
          </div>

          <!-- Software Category -->
          <h2 class="text-neutral-700 dark:text-neutral-300 text-lg font-semibold mb-4">Minecraft Software & Runtime</h2>
          <div class="grid grid-cols-1 gap-4 mb-6">
            <div>
              <label for="softwareType" class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-400 text-sm tracking-tight mb-2">
                <%- icon('box', { size: 14, class: 'shrink-0' }) %>
                Server Software:
              </label>
              <select id="softwareType" name="softwareType" class="rounded-xl focus:ring focus:ring-neutral-800/10 focus:border-neutral-800/20 text-neutral-800 dark:text-white text-sm mt-2 mb-4 w-full hover:bg-white/5 px-4 py-2 bg-neutral-400/10 dark:bg-neutral-600/20 border border-neutral-800/10 dark:border-white/5">
                <option value="paper" selected>Paper (Recommended)</option>
                <option value="purpur">Purpur</option>
                <option value="vanilla">Vanilla</option>
                <option value="fabric">Fabric</option>
                <option value="forge">Forge</option>
                <option value="neoforge">NeoForge</option>
                <option value="spigot">Spigot</option>
              </select>
            </div>

            <div>
              <label for="softwareVersion" class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-400 text-sm tracking-tight mb-2">
                <%- icon('tag', { size: 14, class: 'shrink-0' }) %>
                Minecraft Version:
              </label>
              <select id="softwareVersion" name="softwareVersion" class="rounded-xl focus:ring focus:ring-neutral-800/10 focus:border-neutral-800/20 text-neutral-800 dark:text-white text-sm mt-2 mb-4 w-full hover:bg-white/5 px-4 py-2 bg-neutral-400/10 dark:bg-neutral-600/20 border border-neutral-800/10 dark:border-white/5">
                <option value="1.21.4" selected>1.21.4</option>
                <option value="1.21.3">1.21.3</option>
                <option value="1.21.1">1.21.1</option>
                <option value="1.20.4">1.20.4</option>
                <option value="1.20.1">1.20.1</option>
                <option value="1.19.4">1.19.4</option>
                <option value="1.18.2">1.18.2</option>
                <option value="1.16.5">1.16.5</option>
              </select>
            </div>

            <div>
              <label for="javaVersion" class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-400 text-sm tracking-tight mb-2">
                <%- icon('terminal', { size: 14, class: 'shrink-0' }) %>
                Java Version:
              </label>
              <select id="javaVersion" name="javaVersion" class="rounded-xl focus:ring focus:ring-neutral-800/10 focus:border-neutral-800/20 text-neutral-800 dark:text-white text-sm mt-2 mb-4 w-full hover:bg-white/5 px-4 py-2 bg-neutral-400/10 dark:bg-neutral-600/20 border border-neutral-800/10 dark:border-white/5">
                <option value="21" selected>Java 21 (For 1.20.5+)</option>
                <option value="17">Java 17 (For 1.17 - 1.20.4)</option>
                <option value="11">Java 11 (Legacy 1.12 - 1.16)</option>
                <option value="8">Java 8 (Legacy 1.8.8)</option>
              </select>
            </div>
          </div>

          <!-- Resources Category -->
          <h2 class="text-neutral-700 dark:text-neutral-300 text-lg font-semibold mb-4">Resources</h2>
          <div class="grid grid-cols-1 gap-4 mb-6">
            <div>
              <label class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-400 text-sm tracking-tight mb-2">
                <%- icon('settings', { size: 14, class: 'shrink-0' }) %>
                CPU:
              </label>
              <input type="hidden" id="serverCPU" name="Cpu" value="100">
              <div class="flex items-stretch mt-2 mb-1 gap-0">
                <input id="serverCPUDisplay" type="number" min="0.5" step="0.5" value="1" class="rounded-l-xl flex-1 focus:ring focus:ring-neutral-800/10 focus:border-neutral-800/20 text-neutral-800 dark:text-white text-sm hover:bg-white/5 px-4 py-2 bg-neutral-400/10 dark:bg-neutral-600/20 border border-r-0 border-neutral-800/10 dark:border-white/5">
                <select id="serverCPUUnit" class="rounded-r-xl text-sm px-2 py-2 bg-neutral-200 dark:bg-neutral-700 text-neutral-800 dark:text-white border border-neutral-800/10 dark:border-white/5 cursor-pointer">
                  <option value="cores" selected>Cores</option>
                  <option value="percent">%</option>
                </select>
              </div>
            </div>

            <div>
              <label class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-400 text-sm tracking-tight mb-2">
                <%- icon('server', { size: 14, class: 'shrink-0' }) %>
                Memory:
              </label>
              <input type="hidden" id="serverMemory" name="Memory" value="1024">
              <div class="flex items-stretch mt-2 mb-1 gap-0">
                <input id="serverMemoryDisplay" type="number" min="1" value="1"
                  class="rounded-l-xl flex-1 focus:ring focus:ring-neutral-800/10 focus:border-neutral-800/20 text-neutral-800 dark:text-white text-sm hover:bg-white/5 px-4 py-2 bg-neutral-400/10 dark:bg-neutral-600/20 border border-r-0 border-neutral-800/10 dark:border-white/5">
                <select id="serverMemoryUnit" class="rounded-r-xl text-sm px-2 py-2 bg-neutral-200 dark:bg-neutral-700 text-neutral-800 dark:text-white border border-neutral-800/10 dark:border-white/5 cursor-pointer">
                  <option value="1">MB</option>
                  <option value="1024" selected>GB</option>
                </select>
              </div>
            </div>

            <div>
              <label class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-400 text-sm tracking-tight mb-2">
                <%- icon('database', { size: 14, class: 'shrink-0' }) %>
                Storage:
              </label>
              <input type="hidden" id="serverStorage" name="Storage" value="20480">
              <div class="flex items-stretch mt-2 mb-1 gap-0">
                <input id="serverStorageDisplay" type="number" min="1" value="20"
                  class="rounded-l-xl flex-1 focus:ring focus:ring-neutral-800/10 focus:border-neutral-800/20 text-neutral-800 dark:text-white text-sm hover:bg-white/5 px-4 py-2 bg-neutral-400/10 dark:bg-neutral-600/20 border border-r-0 border-neutral-800/10 dark:border-white/5">
                <select id="serverStorageUnit" class="rounded-r-xl text-sm px-2 py-2 bg-neutral-200 dark:bg-neutral-700 text-neutral-800 dark:text-white border border-neutral-800/10 dark:border-white/5 cursor-pointer">
                  <option value="1">MB</option>
                  <option value="1024" selected>GB</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Submit Button -->
          <div>
            <button type="submit" class="w-full rounded-xl bg-neutral-950 dark:bg-white hover:bg-neutral-800 dark:hover:bg-neutral-200 text-white dark:text-neutral-900 px-4 py-3 text-sm font-semibold shadow-md transition">
              <%= req.translations.create || 'Create Minecraft Server' %>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</main>

<%- include('../../components/toast') %>
<%- include('../../components/loadingPopup') %>

<script nonce="<%- nonce %>">
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('createServerForm');
    const softwareType = document.getElementById('softwareType');
    const softwareVersion = document.getElementById('softwareVersion');

    softwareType.addEventListener('change', async () => {
      try {
        const res = await fetch('/api/mcjars/versions/' + softwareType.value);
        const data = await res.json();
        if (data && Array.isArray(data.versions) && data.versions.length > 0) {
          softwareVersion.innerHTML = '';
          data.versions.forEach(ver => {
            const opt = document.createElement('option');
            opt.value = ver; opt.textContent = ver;
            softwareVersion.appendChild(opt);
          });
        }
      } catch (e) {}
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const data = Object.fromEntries(formData);

      const loader = showLoadingPopup('Creating Server', 'Provisioning Minecraft server...');
      fetch('/admin/servers/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      })
        .then(res => { if (!res.ok) throw new Error('Failed'); return res; })
        .then(() => {
          loader.close();
          showToast('Minecraft server created!', 'success');
          setTimeout(() => { window.location.href = '/admin/servers'; }, 800);
        })
        .catch(err => {
          loader.close();
          showToast('Failed to create server', 'error');
        });
    });

    function syncUnit(displayId, unitId, hiddenId) {
      const display = document.getElementById(displayId);
      const unit    = document.getElementById(unitId);
      const hidden  = document.getElementById(hiddenId);
      function update() { hidden.value = Math.round(parseFloat(display.value || 0) * parseInt(unit.value)); }
      display.addEventListener('input', update);
      unit.addEventListener('change', update);
      update();
    }
    syncUnit('serverMemoryDisplay',  'serverMemoryUnit',  'serverMemory');
    syncUnit('serverStorageDisplay', 'serverStorageUnit', 'serverStorage');
  });

  const listA = ["Charged", "Fiery", "Mystical", "Dark", "Angry", "Enchanted", "Blazing"];
  const listB = ["Creeper", "Dragon", "Zombie", "Ghoul", "Enderman", "Skeleton", "Wither"];
  function generateRandomName() {
    const randomA = listA[Math.floor(Math.random() * listA.length)];
    const randomB = listB[Math.floor(Math.random() * listB.length)];
    document.getElementById("serverName").value = randomA + " " + randomB;
  }
</script>
